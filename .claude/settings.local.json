{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:docs.github.com)",
      "WebFetch(domain:docs.openclaw.ai)",
      "WebFetch(domain:openclaw.ai)",
      "WebFetch(domain:docs.anthropic.com)",

      "Bash(*)",

      "Skill(notion-cli)",
      "mcp__context7__query-docs",
      "mcp__notion__API-get-self"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf /:*)",

      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf $HOME)",
      "Bash(rm -rf $HOME/*)",

      "Bash(rm -rf .)",
      "Bash(rm -rf ./)",
      "Bash(rm -rf ./*)",
      "Bash(rm -rf ..)",
      "Bash(rm -rf ../*)",

      "Bash(rm -rf .git)",
      "Bash(rm -rf .git/)",
      "Bash(rm -rf .git/*)",
      "Bash(rm -rf */.git)",
      "Bash(rm -rf */.git/*)",

      "Bash(sudo rm:*)",
      "Bash(sudo chmod:*)",
      "Bash(sudo chown:*)",
      "Bash(chmod -R 777:*)",
      "Bash(chmod -R 777 *)",
      "Bash(chown -R:*)",

      "Bash(mkfs:*)",
      "Bash(dd if:*)",
      "Bash(dd of:*)",
      "Bash(diskutil eraseDisk:*)",
      "Bash(diskutil partitionDisk:*)",

      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(wget * | sh)",
      "Bash(wget * | bash)",

      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(git clean -fdx:*)",

      "Bash(kubectl delete:*)",
      "Bash(kubectl apply -f:*)",
      "Bash(kubectl replace:*)",
      "Bash(kubectl scale:*)",
      "Bash(kubectl rollout restart:*)",
      "Bash(kubectl patch:*)",
      "Bash(helm uninstall:*)",
      "Bash(helm delete:*)",
      "Bash(helm upgrade:*)",

      "Bash(docker system prune:*)",
      "Bash(docker container prune:*)",
      "Bash(docker image prune:*)",
      "Bash(docker volume prune:*)",
      "Bash(docker network prune:*)",
      "Bash(docker rm:*)",
      "Bash(docker rmi:*)",
      "Bash(docker volume rm:*)",

      "Bash(op item delete:*)",
      "Bash(op item edit:*)",
      "Bash(op item create:*)",
      "Bash(op vault delete:*)",

      "Bash(gcloud projects delete:*)",
      "Bash(gcloud compute instances delete:*)",
      "Bash(gcloud container clusters delete:*)",
      "Bash(aws s3 rm:*)",
      "Bash(aws s3 rb:*)",
      "Bash(aws cloudformation delete-stack:*)",
      "Bash(az group delete:*)"
    ]
  },
  "outputStyle": "Explanatory"
}
